{
  "manifest_version": 3,
  "name": "Einführungskurs für Scratch – Tutorials auf Deutsch",
  "version": "1.2.0",
  "description": "Deutsche Scratch-Tutorials und ein geführter Programmierkurs für Kinder – direkt im Scratch-Editor. Für Schule, AG und Zuhause.",
  "homepage_url": "https://simonprell-dev.github.io/scratchExtention/",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Einführungskurs für Scratch",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "contextMenus",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://scratch.mit.edu/*"
  ]
}
