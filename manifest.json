{
  "manifest_version": 3,
  "name": "Scratch Tutorials auf Deutsch + BayernLab Kurs",
  "version": "1.1.0",
  "description": "Zeigt die Blöcke in den Scratch-Tutorials auf Deutsch und bietet einen geführten BayernLab-Scratch-Kurs.",
  "content_scripts": [
    {
      "matches": ["https://scratch.mit.edu/*"],
      "js": [
        "lib/scratchblocks.min.js",
        "lib/scratchblocks-de.js",
        "lib/scratch-access.js",
        "data/steps-de.js",
        "content.js",
        "course/course-data.js",
        "course/course.js"
      ],
      "css": ["content.css", "course/course.css"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
