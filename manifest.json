{
  "manifest_version": 3,
  "name": "Scratch Tutorials auf Deutsch + Einführungskurs",
  "version": "1.2.0",
  "description": "Scratch-Tutorials mit deutschen Blöcken und ein geführter Scratch-Einführungskurs direkt im Editor.",
  "homepage_url": "https://github.com/simonprell-dev/scratchExtention",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Scratch auf Deutsch + Einführungskurs",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "contextMenus",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://scratch.mit.edu/*"
  ]
}
